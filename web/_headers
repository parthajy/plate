# Cache static assets aggressively; HTML stays fresh-ish.
# Netlify reads this file automatically.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400

# Force browsers to download the APK as a file, with the correct MIME type
# so Android recognises it as installable. Update this file whenever a new
# verification build is needed; the URL is stable.
/plate-latest.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="plate-latest.apk"
  Cache-Control: public, max-age=3600
