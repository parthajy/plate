# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (local dev uses docker-compose Postgres on 5432)
DATABASE_URL=postgresql://plate:plate@localhost:5432/plate_dev

# JWT secrets (32+ random chars each — generate with `openssl rand -hex 32`)
JWT_SECRET=replace-me-with-a-real-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-me-with-a-different-secret-at-least-32-chars

# Anthropic (Phase 2+; not required for Phase 0)
ANTHROPIC_API_KEY=

# DO Spaces (Phase 2+; not required for Phase 0)
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_ACCESS_KEY=
SPACES_SECRET=

# OAuth (Phase 2+; not required for Phase 0)
APPLE_CLIENT_ID=best.plate.app
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# RevenueCat webhook auth. Set the same value in RC dashboard → Project
# Settings → Webhooks → "Authorization header value". Generate with
# `openssl rand -hex 32`.
REVENUECAT_WEBHOOK_SECRET=

# Observability (optional)
SENTRY_DSN=
