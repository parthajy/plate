{
  "name": "plate",
  "private": true,
  "version": "0.0.0",
  "description": "PLATE — fitness + nutrition app. Mobile (Expo) + backend (Fastify) + shared Zod schemas.",
  "workspaces": [
    "shared",
    "backend",
    "mobile"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace=@plate/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:db": "docker compose -f infra/docker-compose.dev.yml up -d",
    "dev:db:stop": "docker compose -f infra/docker-compose.dev.yml down",
    "dev:backend": "npm run build:shared && npm run dev --workspace=@plate/backend",
    "dev:mobile": "npm run build:shared && npm run start --workspace=@plate/mobile",
    "postinstall": "npm run build:shared --if-present",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "lefthook": "^1.10.0",
    "prettier": "^3.4.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
