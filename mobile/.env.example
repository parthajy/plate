# Public values exposed to the Expo bundle. NEVER put secrets here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL_PROD=https://api.plate.best

# RevenueCat public SDK keys (safe to ship in bundle — they are billing-
# proxy keys, not secrets). Get them from RevenueCat → Project settings →
# API Keys. During sandbox testing you can use the same `test_*` key for
# both. In production each platform gets its own key (`appl_*`, `goog_*`).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxx
