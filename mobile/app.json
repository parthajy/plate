{
  "expo": {
    "name": "PLATE",
    "slug": "plate",
    "scheme": "plate",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#0b0b0a",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "best.plate.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIBackgroundColor": "#0b0b0a",
        "NSCameraUsageDescription": "Plate uses your camera to scan food and estimate calories and macros.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "best.plate.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dcff4f"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Plate uses your camera to scan food and estimate calories and macros."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0a"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b102ba0a-8c08-441c-842d-5c6ef4d15b4b"
      }
    }
  }
}
